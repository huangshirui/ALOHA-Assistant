{
  "name": "ALOHA M4 LifeSpace Read Runtime",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "aloha-m4-lifespace-read",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "id": "14111111-1111-4111-8111-111111111111",
      "name": "ALOHA Runtime Webhook",
      "webhookId": "24111111-1111-4111-8111-111111111111"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.input.text }}",
        "options": {
          "systemMessage": "You are the execution backend for ALOHA Assistant M4. ALOHA may provide a LifeSpace Read tool through the trusted Run Envelope. When the user's request needs LifeSpace data, call LifeSpace Discover first and use only the Spaces, model routes, fields, query metadata and effective access returned by discovery. Then use LifeSpace Query for the needed read. Never invent Space IDs, model routes, fields, permissions, tool URLs, grants, identity or private context. Do not attempt mutations or actions in M4. If LifeSpace denies an operation, treat that denial as authoritative.",
          "returnIntermediateSteps": true
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [320, 0],
      "id": "34111111-1111-4111-8111-111111111111",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [240, 280],
      "id": "44111111-1111-4111-8111-111111111111",
      "name": "Example Chat Model"
    },
    {
      "parameters": {
        "toolDescription": "Discover the current ALOHA user's effective LifeSpace read surface. Always call this before querying LifeSpace so you use only currently authorized Space IDs, model routes, fields and query metadata.",
        "method": "POST",
        "url": "={{ $('ALOHA Runtime Webhook').item.json.body.tools.find((tool) => tool.id === 'lifespace.read').invocation.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $('ALOHA Runtime Webhook').item.json.body.tools.find((tool) => tool.id === 'lifespace.read').invocation.authorization }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { input: { operation: 'discover' } } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.3,
      "position": [440, 280],
      "id": "54111111-1111-4111-8111-111111111111",
      "name": "LifeSpace Discover"
    },
    {
      "parameters": {
        "toolDescription": "Read a LifeSpace model collection after discovery. Use a Space ID and model route returned by LifeSpace Discover. Search is optional; pass an empty string when no full-text search is needed. M4 is read-only.",
        "method": "POST",
        "url": "={{ $('ALOHA Runtime Webhook').item.json.body.tools.find((tool) => tool.id === 'lifespace.read').invocation.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $('ALOHA Runtime Webhook').item.json.body.tools.find((tool) => tool.id === 'lifespace.read').invocation.authorization }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { input: { operation: 'query', spaceId: $fromAI('spaceId', 'A Space ID returned by LifeSpace Discover.', 'string'), modelRoute: $fromAI('modelRoute', 'A model route returned by LifeSpace Discover.', 'string'), query: { q: $fromAI('search', 'Optional full-text search value. Use an empty string when no search is needed.', 'string'), limit: $fromAI('limit', 'Maximum number of records to return, normally 20 or fewer.', 'number') } } } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.3,
      "position": [640, 280],
      "id": "64111111-1111-4111-8111-111111111111",
      "name": "LifeSpace Query"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { outputText: $json.output, backendRunId: $execution.id } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [680, 0],
      "id": "74111111-1111-4111-8111-111111111111",
      "name": "Normalize Runtime Result"
    }
  ],
