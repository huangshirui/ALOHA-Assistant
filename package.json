{
  "name": "aloha-assistant",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "workers/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "npm run dev -w @aloha/web",
    "dev:gateway": "npm run dev -w @aloha/gateway",
    "dev:agent-control": "npm run dev -w @aloha/agent-control",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build -w @aloha/web",
    "verify:m1-runtime": "node scripts/verify-m1-runtime.mjs",
    "verify:m2-runtime": "node scripts/verify-m2-runtime.mjs",
    "validate:assets": "node scripts/validate-public-assets.mjs",
    "check": "npm run typecheck && npm run test && npm run validate:assets && npm run build"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
