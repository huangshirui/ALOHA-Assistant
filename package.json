{
  "name": "aloha-assistant",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "workers/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "npm run dev -w @aloha/web",
    "dev:gateway": "npm run dev -w @aloha/gateway",
    "dev:agent-control": "npm run dev -w @aloha/agent-control",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build -w @aloha/web",
    "check": "npm run typecheck && npm run build"
  }
}
