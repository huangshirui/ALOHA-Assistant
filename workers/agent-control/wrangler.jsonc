{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aloha-agent-control",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ALOHA_STATE",
        "class_name": "AlohaConversationState"
      }
    ]
  },
  "exports": {
    "AlohaUserState": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "AlohaConversationState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "secrets": {
    "required": ["N8N_AGENT_WEBHOOK_URL", "N8N_AGENT_AUTH_TOKEN"]
  }
}
